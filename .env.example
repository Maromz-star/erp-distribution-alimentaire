# Copiez ce fichier en .env et remplissez les valeurs reelles avant de lancer l'app.

# Chaine de connexion PostgreSQL
# Exemple local : postgresql://postgres:motdepasse@localhost:5432/erp_distribution
DATABASE_URL="postgresql://user:password@localhost:5432/erp_distribution"

# Secret utilise pour signer les tokens JWT de session (chaine aleatoire longue, ex: openssl rand -base64 48)
JWT_SECRET="change-moi-en-production-avec-une-vraie-cle-secrete"

# Duree de validite du token de session, en secondes (86400 = 24h)
JWT_EXPIRES_IN=86400

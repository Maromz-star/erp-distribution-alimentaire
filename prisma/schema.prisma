// ============================================================================
// SCHEMA DE BASE DE DONNEES - ERP Distribution Alimentaire
// PostgreSQL + Prisma
//
// Convention : tous les montants sont stockés en Decimal(12,2) pour éviter
// les erreurs d'arrondi liées aux flottants. Toutes les tables ont un id
// cuid() (identifiant unique, triable, sans collision) plutôt qu'un entier
// auto-incrémenté, pour rester compatible avec une future architecture
// distribuée / multi-dépôts.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// UTILISATEURS & ROLES
// ----------------------------------------------------------------------------

enum Role {
  ADMIN // accès total : utilisateurs, paramètres, tous les modules
  EMPLOYE // ventes, achats, stock, clients, fournisseurs - pas de gestion des utilisateurs
  COMMERCIAL // ventes et clients uniquement, lecture seule sur le reste
}

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  motDePasse   String // hash bcrypt, jamais en clair
  role         Role     @default(EMPLOYE)
  actif        Boolean  @default(true)
  creeLe       DateTime @default(now())

  ventes       Vente[]
  livraisons   Livraison[]
  bonsLivraisonClient BonLivraisonClient[]
  facturesFournisseurs FactureFournisseur[]
  reglements   Reglement[]
  paiementsF   PaiementFournisseur[]
  mouvements   MouvementStock[]
  journaux     JournalAction[]

  @@map("utilisateurs")
}

// Journal des actions (traçabilité / audit)
model JournalAction {
  id         String   @id @default(cuid())
  utilisateur User    @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  action     String   // ex: "VENTE_CREEE", "PRODUIT_MODIFIE", "CONNEXION"
  cible      String?  // ex: "Vente#ck123", "Produit#ck456"
  details    Json?
  creeLe     DateTime @default(now())

  @@index([utilisateurId])
  @@index([creeLe])
  @@map("journal_actions")
}

// ----------------------------------------------------------------------------
// PRODUITS
// ----------------------------------------------------------------------------

enum StatutProduit {
  ACTIF
  INACTIF
  ARCHIVE
}

model Categorie {
  id            String       @id @default(cuid())
  nom           String
  sousCategories SousCategorie[]
  produits      Produit[]

  @@map("categories")
}

model SousCategorie {
  id          String    @id @default(cuid())
  nom         String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  categorieId String
  produits    Produit[]

  @@map("sous_categories")
}

model Marque {
  id       String    @id @default(cuid())
  nom      String    @unique
  produits Produit[]

  @@map("marques")
}

model Produit {
  id               String         @id @default(cuid())
  codeProduit      String         @unique
  codeBarre        String?        @unique
  nom              String
  categorie        Categorie?     @relation(fields: [categorieId], references: [id])
  categorieId      String?
  sousCategorie    SousCategorie? @relation(fields: [sousCategorieId], references: [id])
  sousCategorieId  String?
  marque           Marque?        @relation(fields: [marqueId], references: [id])
  marqueId         String?
  description      String?
  photoPrincipale  String?        // chemin/URL du fichier
  photos           ProduitPhoto[]

  prixAchat        Decimal        @db.Decimal(12, 2)
  prixVente        Decimal        @db.Decimal(12, 2)
  prixPromo        Decimal?       @db.Decimal(12, 2)
  tauxTVA          Decimal        @db.Decimal(5, 2) @default(20)
  unite            String         @default("unite") // unite, kg, litre, carton...

  quantiteStock    Decimal        @db.Decimal(12, 3) @default(0)
  quantiteReservee Decimal        @db.Decimal(12, 3) @default(0)
  stockMin         Decimal        @db.Decimal(12, 3) @default(0)
  stockMax         Decimal?       @db.Decimal(12, 3)
  emplacement      String?

  fournisseurPrincipal   Fournisseur? @relation(fields: [fournisseurPrincipalId], references: [id])
  fournisseurPrincipalId String?

  datePeremption   DateTime?      // optionnel, pour produits alimentaires perissables
  statut           StatutProduit  @default(ACTIF)
  creeLe           DateTime       @default(now())
  modifieLe        DateTime       @updatedAt

  ligneVentes      LigneVente[]
  lignesLivraison  LigneLivraison[]
  lignesBonLivraisonClient LigneBonLivraisonClient[]
  lignesFactureFournisseur LigneFactureFournisseur[]
  mouvements       MouvementStock[]

  @@index([nom])
  @@index([statut])
  @@map("produits")
}

model ProduitPhoto {
  id        String  @id @default(cuid())
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  produitId String
  url       String
  ordre     Int     @default(0)

  @@map("produit_photos")
}

// ----------------------------------------------------------------------------
// FOURNISSEURS
// ----------------------------------------------------------------------------

model Fournisseur {
  id          String   @id @default(cuid())
  nom         String
  societe     String?
  telephone   String?
  mobile      String?
  email       String?
  adresse     String?
  ville       String?
  pays        String?  @default("Maroc")
  ice         String?
  identifiantFiscal String?
  registreCommerce  String?
  personneContact   String?
  conditionsPaiement String? // ex: "30 jours net", "Comptant"
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())

  produits    Produit[]
  livraisons  Livraison[]
  facturesFournisseurs FactureFournisseur[]
  paiements   PaiementFournisseur[]

  @@map("fournisseurs")
}

// ----------------------------------------------------------------------------
// CLIENTS
// ----------------------------------------------------------------------------

model Client {
  id          String   @id @default(cuid())
  nom         String
  societe     String?
  telephone   String?
  mobile      String?
  email       String?
  adresse     String?
  ville       String?
  pays        String?  @default("Maroc")
  ice         String?
  identifiantFiscal String?
  registreCommerce  String?
  personneContact   String?
  plafondCredit     Decimal? @db.Decimal(12, 2)
  commentaires      String?
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())

  ventes      Vente[]
  bonsLivraisonClient BonLivraisonClient[]
  reglements  Reglement[]

  @@map("clients")
}

// ----------------------------------------------------------------------------
// VENTES
// ----------------------------------------------------------------------------

enum StatutVente {
  BROUILLON   // panier en cours, stock non decremente
  VALIDEE     // stock decremente, facture generee
  ANNULEE
}

model Vente {
  id           String       @id @default(cuid())
  numeroFacture String      @unique
  client       Client       @relation(fields: [clientId], references: [id])
  clientId     String
  utilisateur  User         @relation(fields: [utilisateurId], references: [id])
  utilisateurId String

  // facture generee a partir d'un bon de livraison client (obligatoire pour
  // toute nouvelle vente : pas de facture sans bon de livraison emis avant).
  bonLivraisonClient   BonLivraisonClient? @relation(fields: [bonLivraisonClientId], references: [id])
  bonLivraisonClientId String?            @unique

  lignes       LigneVente[]
  reglements   Reglement[]

  sousTotalHT  Decimal      @db.Decimal(12, 2) @default(0)
  totalRemise  Decimal      @db.Decimal(12, 2) @default(0)
  totalTVA     Decimal      @db.Decimal(12, 2) @default(0)
  totalTTC     Decimal      @db.Decimal(12, 2) @default(0)
  montantPaye  Decimal      @db.Decimal(12, 2) @default(0)
  // solde restant = calcule a la volee (totalTTC - montantPaye), pas stocke

  statut       StatutVente  @default(VALIDEE)
  commentaires String?
  creeLe       DateTime     @default(now())

  @@index([clientId])
  @@index([creeLe])
  @@map("ventes")
}

model LigneVente {
  id          String  @id @default(cuid())
  vente       Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  venteId     String
  produit     Produit @relation(fields: [produitId], references: [id])
  produitId   String
  quantite    Decimal @db.Decimal(12, 3)
  prixUnitaire Decimal @db.Decimal(12, 2) // prix au moment de la vente (historise, independant du prix produit actuel)
  remisePct   Decimal @db.Decimal(5, 2) @default(0)
  tauxTVA     Decimal @db.Decimal(5, 2)
  totalLigneHT  Decimal @db.Decimal(12, 2)
  totalLigneTTC Decimal @db.Decimal(12, 2)

  @@map("lignes_vente")
}

// ----------------------------------------------------------------------------
// BONS DE LIVRAISON CLIENT (flux preparation de livraison)
// ----------------------------------------------------------------------------

enum StatutBonLivraisonClient {
  BROUILLON
  VALIDEE
  FACTUREE
  ANNULEE
}

model BonLivraisonClient {
  id            String                    @id @default(cuid())
  numeroSerie   String                    // serie du document (ex: annee "2026")
  numeroBon     String                    @unique
  client        Client                    @relation(fields: [clientId], references: [id])
  clientId      String
  utilisateur   User                      @relation(fields: [utilisateurId], references: [id])
  utilisateurId  String

  lignes        LigneBonLivraisonClient[]

  sousTotalHT   Decimal                   @db.Decimal(12, 2) @default(0)
  totalRemise   Decimal                   @db.Decimal(12, 2) @default(0)
  totalTVA      Decimal                   @db.Decimal(12, 2) @default(0)
  totalTTC      Decimal                   @db.Decimal(12, 2) @default(0)
  statut        StatutBonLivraisonClient  @default(BROUILLON)
  dateLivraison DateTime                  @default(now())
  commentaires  String?
  creeLe        DateTime                  @default(now())

  // une fois facture, le bon de livraison est lie a SA facture (1-1) ;
  // tant que "vente" est null, aucune facture n'a ete emise pour ce bon.
  vente         Vente?

  @@index([clientId])
  @@index([dateLivraison])
  @@map("bons_livraison_client")
}

model LigneBonLivraisonClient {
  id                    String                @id @default(cuid())
  bonLivraisonClient    BonLivraisonClient    @relation(fields: [bonLivraisonClientId], references: [id], onDelete: Cascade)
  bonLivraisonClientId  String
  produit               Produit                @relation(fields: [produitId], references: [id])
  produitId             String
  quantite              Decimal               @db.Decimal(12, 3)
  prixUnitaire          Decimal               @db.Decimal(12, 2)
  remisePct             Decimal               @db.Decimal(5, 2) @default(0)
  tauxTVA               Decimal               @db.Decimal(5, 2)
  totalLigneHT          Decimal               @db.Decimal(12, 2)
  totalLigneTTC         Decimal               @db.Decimal(12, 2)

  @@map("lignes_bon_livraison_client")
}

// ----------------------------------------------------------------------------
// LIVRAISONS FOURNISSEURS (achats / réceptions de stock)
// ----------------------------------------------------------------------------

enum StatutLivraison {
  BROUILLON
  VALIDEE   // stock incremente
  ANNULEE
}

model Livraison {
  id            String            @id @default(cuid())
  numeroBon     String            @unique
  fournisseur   Fournisseur       @relation(fields: [fournisseurId], references: [id])
  fournisseurId String
  utilisateur   User              @relation(fields: [utilisateurId], references: [id])
  utilisateurId String

  lignes        LigneLivraison[]
  paiements     PaiementFournisseur[]
  factures      FactureFournisseur[]

  totalHT       Decimal           @db.Decimal(12, 2) @default(0)
  totalTTC      Decimal           @db.Decimal(12, 2) @default(0)
  montantPaye   Decimal           @db.Decimal(12, 2) @default(0)

  statut        StatutLivraison   @default(VALIDEE)
  dateLivraison DateTime          @default(now())
  commentaires  String?
  creeLe        DateTime          @default(now())

  @@index([fournisseurId])
  @@index([dateLivraison])
  @@map("livraisons")
}

model LigneLivraison {
  id           String    @id @default(cuid())
  livraison    Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  livraisonId  String
  produit      Produit   @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Decimal   @db.Decimal(12, 3)
  prixAchat    Decimal   @db.Decimal(12, 2)
  totalLigne   Decimal   @db.Decimal(12, 2)

  @@map("lignes_livraison")
}

// ----------------------------------------------------------------------------
// MOUVEMENTS DE STOCK (journal unique = source de verite du stock)
// ----------------------------------------------------------------------------

enum TypeMouvement {
  ENTREE_LIVRAISON
  SORTIE_VENTE
  AJUSTEMENT_POSITIF
  AJUSTEMENT_NEGATIF
  INVENTAIRE
}

model MouvementStock {
  id          String        @id @default(cuid())
  produit     Produit       @relation(fields: [produitId], references: [id])
  produitId   String
  type        TypeMouvement
  quantite    Decimal       @db.Decimal(12, 3) // toujours positif ; le sens est donne par "type"
  stockApres  Decimal       @db.Decimal(12, 3) // solde du stock juste apres ce mouvement (audit)
  reference   String?       // ex: numero de facture ou de bon lie
  utilisateur User?         @relation(fields: [utilisateurId], references: [id])
  utilisateurId String?
  motif       String?
  creeLe      DateTime      @default(now())

  @@index([produitId])
  @@index([creeLe])
  @@map("mouvements_stock")
}

// ----------------------------------------------------------------------------
// FACTURES FOURNISSEURS (document comptable de reception fournisseur)
// ----------------------------------------------------------------------------

enum StatutFactureFournisseur {
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

model FactureFournisseur {
  id            String                    @id @default(cuid())
  numeroFacture String                    @unique
  fournisseur   Fournisseur               @relation(fields: [fournisseurId], references: [id])
  fournisseurId String
  livraison     Livraison?                @relation(fields: [livraisonId], references: [id])
  livraisonId   String?
  utilisateur   User                      @relation(fields: [utilisateurId], references: [id])
  utilisateurId String

  lignes        LigneFactureFournisseur[]

  totalHT       Decimal                   @db.Decimal(12, 2) @default(0)
  totalTTC      Decimal                   @db.Decimal(12, 2) @default(0)
  montantPaye   Decimal                   @db.Decimal(12, 2) @default(0)
  statut        StatutFactureFournisseur @default(EN_ATTENTE)
  dateFacture   DateTime                  @default(now())
  commentaires  String?
  creeLe        DateTime                  @default(now())

  @@index([fournisseurId])
  @@index([dateFacture])
  @@map("factures_fournisseurs")
}

model LigneFactureFournisseur {
  id                   String               @id @default(cuid())
  factureFournisseur   FactureFournisseur   @relation(fields: [factureFournisseurId], references: [id], onDelete: Cascade)
  factureFournisseurId String
  produit              Produit              @relation(fields: [produitId], references: [id])
  produitId            String
  quantite             Decimal              @db.Decimal(12, 3)
  prixUnitaire         Decimal              @db.Decimal(12, 2)
  totalLigne           Decimal              @db.Decimal(12, 2)

  @@map("lignes_facture_fournisseur")
}

// ----------------------------------------------------------------------------
// REGLEMENTS CLIENTS & PAIEMENTS FOURNISSEURS
// ----------------------------------------------------------------------------

enum ModePaiement {
  ESPECES
  VIREMENT
  CHEQUE
  TRAITE
  CARTE_BANCAIRE
}

model Reglement {
  id           String       @id @default(cuid())
  client       Client       @relation(fields: [clientId], references: [id])
  clientId     String
  vente        Vente?       @relation(fields: [venteId], references: [id])
  venteId      String?
  utilisateur  User         @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  montant      Decimal      @db.Decimal(12, 2)
  mode         ModePaiement
  reference    String?      // ex: numero de cheque
  dateReglement DateTime    @default(now())
  commentaires String?

  @@index([clientId])
  @@map("reglements")
}

model PaiementFournisseur {
  id            String       @id @default(cuid())
  fournisseur   Fournisseur  @relation(fields: [fournisseurId], references: [id])
  fournisseurId String
  livraison     Livraison?   @relation(fields: [livraisonId], references: [id])
  livraisonId   String?
  utilisateur   User         @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  montant       Decimal      @db.Decimal(12, 2)
  mode          ModePaiement
  reference     String?
  datePaiement  DateTime     @default(now())
  commentaires  String?

  @@index([fournisseurId])
  @@map("paiements_fournisseurs")
}


// ----------------------------------------------------------------------------
// PARAMETRES ENTREPRISE (societe vendeuse - utilise pour l'en-tete des PDF)
// ----------------------------------------------------------------------------

model ParametreEntreprise {
  id                String   @id @default(cuid())
  nom               String   @default("Mon Entreprise")
  adresse           String?
  ville             String?
  pays              String?  @default("Maroc")
  telephone         String?
  email             String?
  ice               String?
  identifiantFiscal String?
  registreCommerce  String?
  logoUrl           String?  @db.Text
  modifieLe         DateTime @updatedAt

  @@map("parametres_entreprise")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  ADMIN
  GERANT
  COMMERCIAL
  MAGASINIER
  LIVREUR
  COMPTABLE
}

enum StatutUtilisateur {
  ACTIF
  INACTIF
}

enum StatutClient {
  ACTIF
  BLOQUE
}

enum StatutFournisseur {
  ACTIF
  BLOQUE
}

//////////////////////////////////////////////////////
// UTILISATEURS
//////////////////////////////////////////////////////

model User {

  id String @id @default(cuid())

  nom String

  prenom String?

  email String @unique

  telephone String?

  motDePasse String

  role Role

  statut StatutUtilisateur @default(ACTIF)

  photo String?

  derniereConnexion DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  commandes CommandeClient[]

  factures Facture[]

  reglements Reglement[]

}

//////////////////////////////////////////////////////
// CLIENTS
//////////////////////////////////////////////////////

model Client {

  id String @id @default(cuid())

  code String @unique

  raisonSociale String

  nom String?

  prenom String?

  telephone String?

  telephone2 String?

  email String?

  adresse String?

  ville String?

  pays String? @default("Maroc")

  ice String?

  if String?

  patente String?

  plafondCredit Decimal @default(0) @db.Decimal(18,2)

  solde Decimal @default(0) @db.Decimal(18,2)

  statut StatutClient @default(ACTIF)

  remarque String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  commandes CommandeClient[]

}

//////////////////////////////////////////////////////
// FOURNISSEURS
//////////////////////////////////////////////////////

model Fournisseur {

  id String @id @default(cuid())

  code String @unique

  raisonSociale String

  nom String?

  prenom String?

  telephone String?

  telephone2 String?

  email String?

  adresse String?

  ville String?

  pays String? @default("Maroc")

  ice String?

  if String?

  patente String?

  delaiPaiement Int @default(30)

  statut StatutFournisseur @default(ACTIF)

  remarque String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}
//////////////////////////////////////////////////////
// CATEGORIES
//////////////////////////////////////////////////////

model Categorie {

  id String @id @default(cuid())

  nom String @unique

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  sousCategories SousCategorie[]

  produits Produit[]

}

//////////////////////////////////////////////////////
// SOUS CATEGORIES
//////////////////////////////////////////////////////

model SousCategorie {

  id String @id @default(cuid())

  nom String

  categorieId String

  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  produits Produit[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([categorieId, nom])

}

//////////////////////////////////////////////////////
// MARQUES
//////////////////////////////////////////////////////

model Marque {

  id String @id @default(cuid())

  nom String @unique

  description String?

  produits Produit[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// DEPOTS
//////////////////////////////////////////////////////

model Depot {

  id String @id @default(cuid())

  code String @unique

  nom String

  adresse String?

  ville String?

  responsable String?

  actif Boolean @default(true)

  stocks Stock[]

  mouvements MouvementStock[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// PRODUITS
//////////////////////////////////////////////////////

model Produit {

  id String @id @default(cuid())

  code String @unique

  codeBarre String? @unique

  designation String

  description String?

  photo String?

  categorieId String

  sousCategorieId String?

  marqueId String?

  unite String

  prixAchat Decimal @db.Decimal(18,2)

  prixVente Decimal @db.Decimal(18,2)

  tva Decimal @default(20) @db.Decimal(5,2)

  stockMinimum Decimal @default(0) @db.Decimal(18,3)

  actif Boolean @default(true)

  categorie Categorie @relation(fields:[categorieId], references:[id])

  sousCategorie SousCategorie? @relation(fields:[sousCategorieId], references:[id])

  marque Marque? @relation(fields:[marqueId], references:[id])

  stocks Stock[]

  mouvements MouvementStock[]

  lignesCommande LigneCommandeClient[]

  lignesBL LigneBonLivraison[]

  lignesFacture LigneFacture[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// STOCK PAR DEPOT
//////////////////////////////////////////////////////

model Stock {

  id String @id @default(cuid())

  produitId String

  depotId String

  quantite Decimal @default(0) @db.Decimal(18,3)

  produit Produit @relation(fields:[produitId], references:[id], onDelete: Cascade)

  depot Depot @relation(fields:[depotId], references:[id], onDelete: Cascade)

  @@unique([produitId,depotId])

}

//////////////////////////////////////////////////////
// MOUVEMENTS DE STOCK
//////////////////////////////////////////////////////

enum TypeMouvement {

  ENTREE

  SORTIE

  INVENTAIRE

  TRANSFERT

  RETOUR_CLIENT

  RETOUR_FOURNISSEUR

}

model MouvementStock {

  id String @id @default(cuid())

  produitId String

  depotId String

  type TypeMouvement

  quantite Decimal @db.Decimal(18,3)

  stockAvant Decimal @db.Decimal(18,3)

  stockApres Decimal @db.Decimal(18,3)

  reference String?

  commentaire String?

  produit Produit @relation(fields:[produitId], references:[id])

  depot Depot @relation(fields:[depotId], references:[id])

  createdAt DateTime @default(now())

}
//////////////////////////////////////////////////////
// COMMANDES CLIENTS
//////////////////////////////////////////////////////

enum StatutCommande {
  BROUILLON
  VALIDEE
  EN_PREPARATION
  PRETE
  LIVREE
  FACTUREE
  ANNULEE
}

model CommandeClient {

  id String @id @default(cuid())

  numero String @unique

  clientId String

  utilisateurId String

  dateCommande DateTime @default(now())

  statut StatutCommande @default(BROUILLON)

  remise Decimal @default(0) @db.Decimal(18,2)

  totalHT Decimal @default(0) @db.Decimal(18,2)

  totalTVA Decimal @default(0) @db.Decimal(18,2)

  totalTTC Decimal @default(0) @db.Decimal(18,2)

  remarque String?

  client Client @relation(fields:[clientId], references:[id])

  utilisateur User @relation(fields:[utilisateurId], references:[id])

  lignes LigneCommandeClient[]

  bonsLivraison BonLivraison[]

  factures Facture[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// LIGNES COMMANDE
//////////////////////////////////////////////////////

model LigneCommandeClient {

  id String @id @default(cuid())

  commandeId String

  produitId String

  quantite Decimal @db.Decimal(18,3)

  prix Decimal @db.Decimal(18,2)

  remise Decimal @default(0) @db.Decimal(18,2)

  tva Decimal @db.Decimal(5,2)

  total Decimal @db.Decimal(18,2)

  commande CommandeClient @relation(fields:[commandeId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// BONS DE LIVRAISON
//////////////////////////////////////////////////////

enum StatutBL {

  A_PREPARER

  EN_PREPARATION

  PRET

  LIVRE

  ANNULE

}

model BonLivraison {

  id String @id @default(cuid())

  numero String @unique

  commandeId String

  date DateTime @default(now())

  statut StatutBL @default(A_PREPARER)

  chauffeur String?

  vehicule String?

  remarque String?

  commande CommandeClient @relation(fields:[commandeId], references:[id])

  lignes LigneBonLivraison[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// LIGNES BL
//////////////////////////////////////////////////////

model LigneBonLivraison {

  id String @id @default(cuid())

  bonLivraisonId String

  produitId String

  quantite Decimal @db.Decimal(18,3)

  bonLivraison BonLivraison @relation(fields:[bonLivraisonId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// FACTURES
//////////////////////////////////////////////////////

enum StatutFacture {

  NON_PAYEE

  PARTIELLEMENT_PAYEE

  PAYEE

  ANNULEE

}

model Facture {

  id String @id @default(cuid())

  numero String @unique

  commandeId String

  date DateTime @default(now())

  statut StatutFacture @default(NON_PAYEE)

  totalHT Decimal @default(0) @db.Decimal(18,2)

  totalTVA Decimal @default(0) @db.Decimal(18,2)

  totalTTC Decimal @default(0) @db.Decimal(18,2)

  montantPaye Decimal @default(0) @db.Decimal(18,2)

  reste Decimal @default(0) @db.Decimal(18,2)

  commande CommandeClient @relation(fields:[commandeId], references:[id])

  lignes LigneFacture[]

  reglements Reglement[]

  utilisateurId String?

  utilisateur User? @relation(fields:[utilisateurId], references:[id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// LIGNES FACTURE
//////////////////////////////////////////////////////

model LigneFacture {

  id String @id @default(cuid())

  factureId String

  produitId String

  quantite Decimal @db.Decimal(18,3)

  prix Decimal @db.Decimal(18,2)

  remise Decimal @default(0) @db.Decimal(18,2)

  tva Decimal @db.Decimal(5,2)

  total Decimal @db.Decimal(18,2)

  facture Facture @relation(fields:[factureId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// REGLEMENTS
//////////////////////////////////////////////////////

enum ModePaiement {

  ESPECES

  CHEQUE

  VIREMENT

  CARTE

  CREDIT

}

model Reglement {

  id String @id @default(cuid())

  numero String @unique

  factureId String

  utilisateurId String

  montant Decimal @db.Decimal(18,2)

  date DateTime @default(now())

  modePaiement ModePaiement

  reference String?

  remarque String?

  facture Facture @relation(fields:[factureId], references:[id])

  utilisateur User @relation(fields:[utilisateurId], references:[id])

  createdAt DateTime @default(now())

}
//////////////////////////////////////////////////////
// COMMANDES FOURNISSEURS
//////////////////////////////////////////////////////

enum StatutCommandeFournisseur {
  BROUILLON
  ENVOYEE
  PARTIELLEMENT_RECUE
  RECUE
  ANNULEE
}

model CommandeFournisseur {

  id String @id @default(cuid())

  numero String @unique

  fournisseurId String

  utilisateurId String

  dateCommande DateTime @default(now())

  statut StatutCommandeFournisseur @default(BROUILLON)

  totalHT Decimal @default(0) @db.Decimal(18,2)

  totalTVA Decimal @default(0) @db.Decimal(18,2)

  totalTTC Decimal @default(0) @db.Decimal(18,2)

  remarque String?

  fournisseur Fournisseur @relation(fields:[fournisseurId], references:[id])

  utilisateur User @relation(fields:[utilisateurId], references:[id])

  lignes LigneCommandeFournisseur[]

  receptions ReceptionFournisseur[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// LIGNES COMMANDE FOURNISSEUR
//////////////////////////////////////////////////////

model LigneCommandeFournisseur {

  id String @id @default(cuid())

  commandeId String

  produitId String

  quantite Decimal @db.Decimal(18,3)

  prix Decimal @db.Decimal(18,2)

  tva Decimal @db.Decimal(5,2)

  total Decimal @db.Decimal(18,2)

  commande CommandeFournisseur @relation(fields:[commandeId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// RECEPTIONS FOURNISSEURS
//////////////////////////////////////////////////////

enum StatutReception {
  EN_ATTENTE
  RECUE
  CONTROLEE
  ANNULEE
}

model ReceptionFournisseur {

  id String @id @default(cuid())

  numero String @unique

  commandeId String

  dateReception DateTime @default(now())

  statut StatutReception @default(EN_ATTENTE)

  remarque String?

  commande CommandeFournisseur @relation(fields:[commandeId], references:[id])

  lignes LigneReception[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// LIGNES RECEPTION
//////////////////////////////////////////////////////

model LigneReception {

  id String @id @default(cuid())

  receptionId String

  produitId String

  quantiteRecue Decimal @db.Decimal(18,3)

  prix Decimal @db.Decimal(18,2)

  reception ReceptionFournisseur @relation(fields:[receptionId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// INVENTAIRES
//////////////////////////////////////////////////////

enum StatutInventaire {
  BROUILLON
  EN_COURS
  TERMINE
}

model Inventaire {

  id String @id @default(cuid())

  numero String @unique

  depotId String

  utilisateurId String

  dateInventaire DateTime @default(now())

  statut StatutInventaire @default(BROUILLON)

  remarque String?

  depot Depot @relation(fields:[depotId], references:[id])

  utilisateur User @relation(fields:[utilisateurId], references:[id])

  lignes LigneInventaire[]

  createdAt DateTime @default(now())

}

//////////////////////////////////////////////////////
// LIGNES INVENTAIRE
//////////////////////////////////////////////////////

model LigneInventaire {

  id String @id @default(cuid())

  inventaireId String

  produitId String

  stockTheorique Decimal @db.Decimal(18,3)

  stockPhysique Decimal @db.Decimal(18,3)

  ecart Decimal @db.Decimal(18,3)

  inventaire Inventaire @relation(fields:[inventaireId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}

//////////////////////////////////////////////////////
// TRANSFERTS ENTRE DEPOTS
//////////////////////////////////////////////////////

enum StatutTransfert {
  EN_ATTENTE
  EXPEDIE
  RECU
  ANNULE
}

model TransfertStock {

  id String @id @default(cuid())

  numero String @unique

  depotSourceId String

  depotDestinationId String

  utilisateurId String

  date DateTime @default(now())

  statut StatutTransfert @default(EN_ATTENTE)

  depotSource Depot @relation("DepotSource", fields:[depotSourceId], references:[id])

  depotDestination Depot @relation("DepotDestination", fields:[depotDestinationId], references:[id])

  utilisateur User @relation(fields:[utilisateurId], references:[id])

  lignes LigneTransfert[]

  createdAt DateTime @default(now())

}

//////////////////////////////////////////////////////
// LIGNES TRANSFERT
//////////////////////////////////////////////////////

model LigneTransfert {

  id String @id @default(cuid())

  transfertId String

  produitId String

  quantite Decimal @db.Decimal(18,3)

  transfert TransfertStock @relation(fields:[transfertId], references:[id], onDelete: Cascade)

  produit Produit @relation(fields:[produitId], references:[id])

}
//////////////////////////////////////////////////////
// SOCIETE
//////////////////////////////////////////////////////

model Societe {

  id String @id @default(cuid())

  raisonSociale String

  nomCommercial String?

  adresse String?

  ville String?

  pays String?

  telephone String?

  email String?

  siteWeb String?

  ice String?

  if String?

  patente String?

  rc String?

  capital Decimal? @db.Decimal(18,2)

  logo String?

  devise String @default("MAD")

  tvaParDefaut Decimal @default(20) @db.Decimal(5,2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}

//////////////////////////////////////////////////////
// NUMEROTATION DES DOCUMENTS
//////////////////////////////////////////////////////

model Numerotation {

  id String @id @default(cuid())

  typeDocument String @unique

  prefixe String

  prochainNumero Int @default(1)

  longueurNumero Int @default(6)

  suffixe String?

  actif Boolean @default(true)

}

//////////////////////////////////////////////////////
// PARAMETRES
//////////////////////////////////////////////////////

model Parametre {

  id String @id @default(cuid())

  cle String @unique

  valeur String

  description String?

}

//////////////////////////////////////////////////////
// JOURNAL DES ACTIONS
//////////////////////////////////////////////////////

model JournalAction {

  id String @id @default(cuid())

  utilisateurId String?

  module String

  action String

  reference String?

  details Json?

  adresseIP String?

  navigateur String?

  createdAt DateTime @default(now())

  utilisateur User? @relation(fields:[utilisateurId], references:[id])

}

//////////////////////////////////////////////////////
// PIECES JOINTES
//////////////////////////////////////////////////////

model PieceJointe {

  id String @id @default(cuid())

  nom String

  fichier String

  extension String

  taille Int

  module String

  referenceId String

  uploadedBy String?

  createdAt DateTime @default(now())

}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

enum TypeNotification {

  INFO

  SUCCES

  ALERTE

  ERREUR

}

model Notification {

  id String @id @default(cuid())

  utilisateurId String?

  titre String

  message String

  type TypeNotification

  lu Boolean @default(false)

  createdAt DateTime @default(now())

  utilisateur User? @relation(fields:[utilisateurId], references:[id])

}

//////////////////////////////////////////////////////
// HISTORIQUE DES CONNEXIONS
//////////////////////////////////////////////////////

model ConnexionUtilisateur {

  id String @id @default(cuid())

  utilisateurId String

  dateConnexion DateTime @default(now())

  adresseIP String?

  navigateur String?

  appareil String?

  utilisateur User @relation(fields:[utilisateurId], references:[id])

}

//////////////////////////////////////////////////////
// DEVISES
//////////////////////////////////////////////////////

model Devise {

  id String @id @default(cuid())

  code String @unique

  nom String

  symbole String

  taux Decimal @db.Decimal(18,6)

  deviseParDefaut Boolean @default(false)

}

//////////////////////////////////////////////////////
// TAUX TVA
//////////////////////////////////////////////////////

model TauxTVA {

  id String @id @default(cuid())

  nom String

  taux Decimal @db.Decimal(5,2)

  actif Boolean @default(true)

}